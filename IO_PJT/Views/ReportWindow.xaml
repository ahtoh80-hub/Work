<Window x:Class="IO_PJT.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование отчёта — сводка по документам" Width="1050" Height="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- F7.8: отчёт по данным аудита: документ (файл + вкладка) → ячейка (поле) → количество изменений по типам + итоги -->
    <DockPanel Margin="8">

        <!-- Условие отбора (текущие фильтры окна истории) -->
        <Border DockPanel.Dock="Top" Padding="4" Margin="0,0,0,6">
            <TextBlock x:Name="FilterText" TextWrapping="Wrap" FontWeight="SemiBold" />
        </Border>

        <!-- Итоги + кнопки -->
        <Border DockPanel.Dock="Bottom" Padding="4,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Foreground="#666666" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ExportButton" Content="Экспорт в Excel..." Width="130" Click="Export_Click" />
                    <Button Content="Закрыть" Width="90" Margin="6,0,0,0" Click="Close_Click" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="ReportGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <!-- Строка-итог документа -->
                        <DataTrigger Binding="{Binding IsSubtotal}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="#EFF3F8" />
                        </DataTrigger>
                        <!-- Общий итог -->
                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#DDE6F0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Документ (файл :: вкладка)" Binding="{Binding Document}" Width="260" />
                <DataGridTextColumn Header="Ячейка (поле)" Binding="{Binding Field}" Width="*" />
                <DataGridTextColumn Header="Insert" Binding="{Binding InsertCount}" Width="65" />
                <DataGridTextColumn Header="Update" Binding="{Binding UpdateCount}" Width="65" />
                <DataGridTextColumn Header="Delete" Binding="{Binding DeleteCount}" Width="65" />
                <DataGridTextColumn Header="CriticalError" Binding="{Binding CriticalErrorCount}" Width="95"
                                    ToolTipService.ToolTip="Критическая ошибка идентичности (F7.5)" />
                <DataGridTextColumn Header="MarkedDelete" Binding="{Binding MarkedDeleteCount}" Width="100"
                                    ToolTipService.ToolTip="Помечен к удалению при замене документа (F2.11)" />
                <DataGridTextColumn Header="TagCleaned" Binding="{Binding TagCleanedCount}" Width="90"
                                    ToolTipService.ToolTip="Tag очищен от пробелов (F2.15)" />
                <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateCount}" Width="90"
                                    ToolTipService.ToolTip="Задвоение тега между документами (F9.1)" />
                <DataGridTextColumn Header="ModbusWarn" Binding="{Binding ModbusWarningCount}" Width="95"
                                    ToolTipService.ToolTip="Предупреждения связывания с картой Modbus (F9.8)" />
                <DataGridTextColumn Header="ModbusErr" Binding="{Binding ModbusErrorCount}" Width="90"
                                    ToolTipService.ToolTip="Ошибки связывания/адресации Modbus (F9.8)" />
                <DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>