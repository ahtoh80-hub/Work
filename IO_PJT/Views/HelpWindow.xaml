<Window x:Class="IO_PJT.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Руководство пользователя — IO_PJT" Width="860" Height="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- A3: справка — краткое руководство по работе с программой -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>

            <TextBlock Text="IO_PJT — импорт IO List из Excel в Access" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Краткое руководство пользователя" FontSize="13" Foreground="#555" Margin="0,0,0,14" />

            <!-- 1 -->
            <TextBlock Text="1. Открытие базы данных" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="При запуске программа использует базу IO_PJT.accdb рядом с исполняемым файлом. Если база занята другим пользователем или недоступна, программа сообщит об этом и предложит выбрать другой файл базы. Другая база: меню «Файл → Открыть базу данных...». Целевую таблицу выбирают в списке «Таблица» (по умолчанию IO_LIST); новую таблицу можно создать в окне импорта или меню «Таблица → Создать таблицу с нуля...»." />
            </TextBlock>

            <!-- 2 -->
            <TextBlock Text="2. Импорт из Excel (окно «Импорт»)" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" FontSize="12.5" LineHeight="18">
                <Run Text="Шаг 1 — источник: укажите файл .xlsx (кнопка «Обзор...» или перетащите файл в окно), выберите вкладку (лист) и строку начала чтения (первая строка — названия колонок), затем «Считать». Шаг 2 — таблица Access и режим (Добавить/Заменить), галочка «Импорт с аудитом» пишет историю в IO_LIST_Audit. Шаг 3 — привязка колонок: авто-определение срабатывает по именам и алиасам, ручная правка — в колонке «Колонка таблицы (Bind)»; одна колонка таблицы — одна колонка Excel (1:1). Обязательна привязка поля Tag — без неё импорт заблокирован. Шаблоны маппинга сохраняются в самой базе и накладываются поверх авто-определения." />
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Предпросмотр показывает первые 50 строк: красным — некорректные значения, зачёркнутым — пропускаемые строки/значения (F2.12). После настройки — «Apply — записать в базу»: прогресс записи, итоговый отчёт и список ошибок/предупреждений внизу окна." />
            </TextBlock>

            <!-- 3 -->
            <TextBlock Text="3. Новый документ или замена (F2.11)" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Перед импортом программа спросит: «Да» — новый документ; «Нет» — замена существующих. В диалоге замены можно отметить несколько документов сразу (Ctrl/Shift или кнопка «Выбрать все») — это нужно, когда документ делится на ревизии/вкладки. Теги отмеченных документов, которых нет в новом файле, помечаются в REV_Description («Удаляются, отсутствуют в последней версии файла...») и видны красным в истории (MarkedDelete); теги, оставшиеся в новом файле, переносятся на новый документ. Физические удаления не выполняются — удаляйте помеченные строки вручную после проверки." />
            </TextBlock>

            <!-- 4 -->
            <TextBlock Text="4. Повторы тегов (IO_LIST_DublicateTag)" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Повтор тега внутри файла больше не блокирует строку: строка записывается штатным upsert, а все копии тега (включая первую) дополнительно копируются в таблицу IO_LIST_DublicateTag — структура такая же, как у IO_LIST, без уникального индекса. Предупреждение W007 и счётчик «копий» попадают в отчёт импорта. Исключение — массовый маркер: тег, повторяющийся в файле 10 и более раз, считается служебной заглушкой и не записывается вовсе (ошибка E005). Пустые теги (E002) тоже не записываются." />
            </TextBlock>

            <!-- 5 -->
            <TextBlock Text="5. История изменений и отчёты" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Меню «Импорт → История изменений...» (или кнопка «🕘 История»): что и на что менялось — старое/новое значение, документ (файл + вкладка), система, автор, время. Фильтры: Tag, поле, файл, вкладка, система, период. Кнопка «Выгрузить в Excel...» сохраняет выборку; «Формирование отчёта...» строит сводку по документам (F7.8) с итогами и экспортом. Красным подсвечиваются критические ошибки (CriticalError), пометки на удаление (MarkedDelete) и очистки Tag (TagCleaned)." />
            </TextBlock>

            <!-- 6 -->
            <TextBlock Text="6. Журнал событий (главное окно)" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Журнал внизу главного окна: сверху — последнее событие; белый — норма, жёлтый — предупреждение, красный — ошибка. Кнопка «Копировать» переносит журнал в буфер обмена, «Очистить» очищает его на экране (лимит — 5000 строк). Критические ошибки валидации попадают в журнал всегда, даже при выключенной галочке «Импорт с аудитом»." />
            </TextBlock>

            <!-- 7 -->
            <TextBlock Text="7. Если база недоступна" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12.5" LineHeight="18">
                <Run Text="Программа проверяет базу при запуске и при открытии: если файл занят (например, открыт в эксклюзивном режиме в Microsoft Access), вы получите понятное сообщение с причиной. Ожидание ограничено 5 секундами — вместо долгих зависаний операция быстро завершается ошибкой. Непредвиденные ошибки больше не закрывают программу молча: показывается окно с описанием, а подробности — в журнале событий." />
            </TextBlock>

            <!-- 8 -->
            <TextBlock Text="8. О программе" FontSize="14" FontWeight="Bold" Margin="0,8,0,4" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" FontSize="12.5" LineHeight="18">
                <Run Text="Стек: WPF / .NET 8, ClosedXML, OleDb (ACE OLE DB). Модель данных: IOclass.md (100 колонок). Техническое задание: IOLISTtoDB_v0.MD. Разработчик: Решетов Антон." />
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</Window>