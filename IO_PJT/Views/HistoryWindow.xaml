<Window x:Class="IO_PJT.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История изменений — IO_LIST_Audit" Width="1100" Height="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Окно истории (F7): «что на что менялось» + выгрузка в Excel; A2 — кнопки слева,
         фильтры в ScrollViewer, внешний ползунок горизонтальной прокрутки под DataGrid -->
    <DockPanel Margin="8">

        <!-- Верхняя строка: команды слева + фильтры (прокрутка при нехватке ширины) -->
        <Border DockPanel.Dock="Top" Padding="4" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Показать" Command="{Binding RefreshCommand}" Margin="0,0,6,0" MinWidth="90" />
                    <Button Content="Выгрузить в Excel..." Command="{Binding ExportCommand}" Margin="0,0,6,0" />
                    <Button Content="Формирование отчёта..." Command="{Binding ReportCommand}" Margin="0,0,10,0"
                            ToolTip="Сводка по документам (файл + вкладка): количество изменений по каждой ячейке с итогами — F7.8" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              ToolTip="При нехватке ширины окна фильтры прокручиваются по горизонтали">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tag:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="160" Text="{Binding FilterTag, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Поле:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="140" Text="{Binding FilterField, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Файл:" VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Фильтр по документу-источнику (REV_FileName, подстрока) — F7.6" />
                        <TextBox Width="130" Text="{Binding FilterFileName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Вкладка:" VerticalAlignment="Center" Margin="8,0,4,0" ToolTip="Фильтр по вкладке-источнику (REV_Sheet, подстрока) — документ = файл + вкладка (F2.16/F7.7)" />
                        <TextBox Width="90" Text="{Binding FilterSheet, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Система:" VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Фильтр по системе (DCS/SIS/GDS, подстрока) — F7.6" />
                        <TextBox Width="80" Text="{Binding FilterSystem, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="С:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <DatePicker Width="120" SelectedDate="{Binding From}" />
                        <TextBlock Text="По:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <DatePicker Width="120" SelectedDate="{Binding To}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Статус -->
        <Border DockPanel.Dock="Bottom" Padding="4,6">
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
        </Border>

        <!-- A2: внешний ползунок горизонтальной прокрутки (синхронизируется с внутренним
             ScrollViewer DataGrid в code-behind — см. HistoryWindow.xaml.cs) -->
        <DockPanel DockPanel.Dock="Bottom">
            <Slider x:Name="hSlider" Height="18" Margin="4,0,4,2"
                    TickPlacement="BottomRight" AutoToolTipPlacement="BottomRight"
                    ValueChanged="HSlider_ValueChanged"
                    ToolTip="Горизонтальная прокрутка таблицы (внешний ползунок)" />
        </DockPanel>

        <DataGrid x:Name="grid" ItemsSource="{Binding Records}" IsReadOnly="True">
            <DataGrid.RowStyle>
                <!-- Критические ошибки идентичности (CriticalError) — красным (F7.5) -->
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Action}" Value="CriticalError">
                            <Setter Property="Background" Value="#FDE7E9" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- F2.11: пометка на удаление (замена документа) — также красным -->
                        <DataTrigger Binding="{Binding Action}" Value="MarkedDelete">
                            <Setter Property="Background" Value="#FDE7E9" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- F2.15: очистка Tag от пробелов (TagCleaned) — красным -->
                        <DataTrigger Binding="{Binding Action}" Value="TagCleaned">
                            <Setter Property="Background" Value="#FDE7E9" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- F9.1: задвоение тега между документами (Duplicate) — жёлтым -->
                        <DataTrigger Binding="{Binding Action}" Value="Duplicate">
                            <Setter Property="Background" Value="#FFF4CE" />
                            <Setter Property="Foreground" Value="#9C6500" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- F9.8: предупреждения связывания Modbus (ModbusWarning) — жёлтым -->
                        <DataTrigger Binding="{Binding Action}" Value="ModbusWarning">
                            <Setter Property="Background" Value="#FFF4CE" />
                            <Setter Property="Foreground" Value="#9C6500" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- F9.8: ошибки связывания/адресации Modbus (ModbusError) — красным -->
                        <DataTrigger Binding="{Binding Action}" Value="ModbusError">
                            <Setter Property="Background" Value="#FDE7E9" />
                            <Setter Property="Foreground" Value="#C42B1C" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата и время"
                                    Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                <DataGridTextColumn Header="Таблица" Binding="{Binding TableName}" Width="110" />
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="150" />
                <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="90" />
                <DataGridTextColumn Header="Поле" Binding="{Binding FieldName}" Width="160" />
                <DataGridTextColumn Header="Было" Binding="{Binding OldValue}" Width="170" />
                <DataGridTextColumn Header="Стало" Binding="{Binding NewValue}" Width="170" />
                <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="130"
                                    ToolTipService.ToolTip="Документ-источник изменения (REV_FileName) — F7.6" />
                <DataGridTextColumn Header="Вкладка" Binding="{Binding Sheet}" Width="90"
                                    ToolTipService.ToolTip="Вкладка-источник изменения (REV_Sheet); документ = файл + вкладка (F2.16/F7.7)" />
                <DataGridTextColumn Header="Система" Binding="{Binding System}" Width="80"
                                    ToolTipService.ToolTip="Система изменения (DCS/SIS/GDS) — F7.6" />
                <DataGridTextColumn Header="Автор" Binding="{Binding ChangedBy}" Width="150" />
                <DataGridTextColumn Header="Изменение" Binding="{Binding ChangeDescription}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
