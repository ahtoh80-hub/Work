<Window x:Class="IO_PJT.Views.ScadaAlgoInstancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генерация экземпляров типовых алгоритмов (F65)" Width="1560" Height="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <!-- F65: генерация XML логических схем по шаблону (BufScadaPOUS с одним OnePOU):
         экземпляр = контур Loop IO_LIST; привязки «сигнал шаблона → строка TYPNO»
         задают марку (формула Mask/Suffix + конструктор); пагинация — InstancesPerFile
         экземпляров на файл, продолжение нумерации в следующем файле. -->
    <DockPanel Margin="8">

        <Border DockPanel.Dock="Top" Padding="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Построить превью" Command="{Binding BuildCommand}" Width="130" Margin="0,0,6,0"
                        ToolTip="Разобрать шаблон, показать сигналы/марки для первого Loop и статистику контуров" />
                <Button Content="Сгенерировать XML…" Command="{Binding GenerateCommand}" Width="140" Margin="0,0,6,0" FontWeight="SemiBold"
                        ToolTip="Собрать файлы BufScadaPOUS (по InstancesPerFile экземпляров на файл) и записать в папку вывода" />
                <Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}" Width="140" Margin="0,0,6,0"
                        ToolTip="Записать параметры в SCADA_ALGO_SETTINGS" />
                <Button Content="Сохранить привязки" Command="{Binding SaveBindingsCommand}" Width="145" Margin="0,0,6,0"
                        ToolTip="Записать грид привязок в SCADA_ALGO_BINDINGS (полная замена строк шаблона)" />
                <Button Content="Заполнить из TYPNO" Command="{Binding FillBindingsFromTypnoCommand}" Width="130"
                        ToolTip="Эвристика: подобрать маску/суффикс/тип для сигналов по строкам TYPNO текущего шаблона" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="4,6">
            <StackPanel>
                <TextBlock Text="{Binding StatsText}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1F4E79" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ① Шаблон: перечень + путь + код -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="XML-шаблон логической схемы (BufScadaPOUS)" Margin="0,0,0,4">
                <DockPanel Margin="4">
                    <ToolBar DockPanel.Dock="Top">
                        <ComboBox Width="170" ItemsSource="{Binding Templates}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedTemplate}"
                                  ToolTip="Сохранённые шаблоны (SCADA_ALGO_TEMPLATES)" />
                        <Separator />
                        <Button Content="Из файла…" Command="{Binding LoadTemplateFileCommand}"
                                ToolTip="Загрузить XML-шаблон из файла в редактор" />
                        <Button Content="Обновить из файла" Command="{Binding UpdateFromFileCommand}"
                                ToolTip="Перечитать тело текущего шаблона по его пути и сохранить" />
                        <Separator />
                        <Button Content="Сохранить" Command="{Binding SaveTemplateCommand}"
                                ToolTip="Сохранить шаблон в SCADA_ALGO_TEMPLATES (upsert по имени)" />
                        <Button Content="Сохранить как…" Command="{Binding SaveTemplateAsCommand}"
                                ToolTip="Сохранить шаблон под новым именем" />
                        <Button Content="Удалить" Command="{Binding DeleteTemplateCommand}"
                                ToolTip="Удалить текущий шаблон из БД" />
                    </ToolBar>
                    <DockPanel DockPanel.Dock="Top" Margin="0,2">
                        <TextBlock Text="Путь:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Text="{Binding TemplateFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Путь файла-источника шаблона (для «Обновить из файла»)" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TemplateStatus}" Margin="0,4,0,0"
                               Foreground="#444444" TextWrapping="Wrap" />
                    <TextBox Text="{Binding TemplateText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             ToolTip="XML-тело шаблона: BufScadaPOUS с одним OnePOU (POU одного типового алгоритма)" />
                </DockPanel>
            </GroupBox>

            <!-- ② Привязки сигналов ↔ строки TYPNO (марка) -->
            <GroupBox Grid.Row="0" Grid.Column="2" Header="Привязки сигналов шаблона → строки TYPNO (марка)" Margin="0,0,0,4">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Добавить" Command="{Binding AddBindingCommand}" Width="80" Margin="0,0,6,0"
                                ToolTip="Добавить строку привязки вручную" />
                        <Button Content="Удалить" Command="{Binding DeleteBindingCommand}" Width="80" Margin="0,0,12,0"
                                ToolTip="Удалить выбранную привязку" />
                        <TextBlock VerticalAlignment="Center" Foreground="#444444" TextWrapping="Wrap"
                                   Text="Марка = формула(Маска,Суффикс) + Конструктор; предпросмотр — для первого контура" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Bindings}" SelectedItem="{Binding SelectedBinding}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сигнал (Info/блок)" Binding="{Binding Signal}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Маска" Binding="{Binding Mask, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="Суффикс" Binding="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Тип объекта" Binding="{Binding ObjType, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="Конструктор" Binding="{Binding Constructor, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="Марка (первый Loop)" Binding="{Binding MarkPreview}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- ③ Контуры Loop (экземпляры) -->
            <GroupBox Grid.Row="2" Grid.Column="0" Header="Контуры Loop (экземпляры IO_LIST)" Margin="0,4,0,0">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Все" Command="{Binding SelectAllLoopsCommand}" Width="60" Margin="0,0,6,0"
                                ToolTip="Отметить все контуры к генерации" />
                        <Button Content="Снять" Command="{Binding ClearAllLoopsCommand}" Width="60"
                                ToolTip="Снять все галочки" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Loops}" SelectedItem="{Binding SelectedLoop}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Ген." Binding="{Binding Generate, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                            <DataGridTextColumn Header="Loop" Binding="{Binding Loop}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Typno" Binding="{Binding Typno}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Тегов" Binding="{Binding TagCount}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- ④ Настройки генерации + ⑤ строки TYPNO -->
            <Grid Grid.Row="2" Grid.Column="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Настройки генерации">
                    <StackPanel Margin="4">
                        <TextBlock Text="Экземпляров на файл (InstancesPerFile):" TextWrapping="Wrap" />
                        <TextBox Margin="0,2,0,4"
                                 Text="{Binding Settings.InstancesPerFile, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Сколько экземпляров (OnePOU) в одном XML-файле; превышение — следующий файл" />
                        <TextBlock Text="Имя файла ({Template}, {Seq}):" TextWrapping="Wrap" />
                        <TextBox Margin="0,2,0,4"
                                 Text="{Binding Settings.FilePattern, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Шаблон имени файла: {Template} — имя шаблона, {Seq} — № файла (с 1)" />
                        <TextBlock Text="Шаг ID (IdStride):" TextWrapping="Wrap" />
                        <TextBox Margin="0,2,0,4"
                                 Text="{Binding Settings.IdStride, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Шаг сдвига T11ID/cardId между экземплярами в файле (минимум 100)" />
                        <TextBlock Text="Папка вывода (OutDir):" TextWrapping="Wrap" />
                        <DockPanel Margin="0,2,0,0">
                            <Button DockPanel.Dock="Right" Content="Обзор…" Command="{Binding BrowseOutDirCommand}" Width="70" Margin="4,0,0,0"
                                    ToolTip="Выбрать папку для сгенерированных файлов" />
                            <TextBox Text="{Binding Settings.OutDir, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Папка для сгенерированных файлов; пусто — выбор при генерации" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="Строки TYPNO текущего шаблона">
                    <DataGrid ItemsSource="{Binding TypnoRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" FontSize="11" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding No}" Width="40" />
                            <DataGridTextColumn Header="Typno" Binding="{Binding Typno}" Width="120" />
                            <DataGridTextColumn Header="Маска" Binding="{Binding Mask}" Width="60" />
                            <DataGridTextColumn Header="Суффикс" Binding="{Binding Suffix}" Width="70" />
                            <DataGridTextColumn Header="Тип объекта" Binding="{Binding ObjType}" Width="110" />
                            <DataGridTextColumn Header="Шаблон" Binding="{Binding Template}" Width="120" />
                            <DataGridTextColumn Header="Подпись" Binding="{Binding Sign}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
