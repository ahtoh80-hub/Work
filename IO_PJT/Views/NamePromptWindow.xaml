<Window x:Class="IO_PJT.Views.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Имя шаблона привязок" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" FontFamily="Consolas" FontSize="12" MaxLength="255"
                 ToolTip="Имя идентифицирует шаблон в SCADA_TYPNO_MAP (колонка «Шаблон привязок»); сравнение без учёта регистра" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Отмена" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
