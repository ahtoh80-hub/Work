<Window x:Class="IO_PJT.Views.ReplaceDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Взамен какого документа?" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <!-- F2.11/F2.16: выбор заменяемого документа = пара «файл + вкладка» (REV_FileName + REV_Sheet) -->
    <StackPanel Margin="14">
        <TextBlock Text="Выберите документ (файл и вкладку-источник), взамен которого импортируется новый файл:"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <ComboBox x:Name="cboDocs" Height="26" />

        <Border Background="{StaticResource BlueSoft}" BorderBrush="#A9C6DF" BorderThickness="1" Padding="8,6" Margin="0,10,0,12">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="Bold" Text="[Note]:" />
                <Run Text=" Теги выбранного документа (только его вкладки), отсутствующие в новом файле, будут помечены в REV_Description («Удаляются, отсутствуют в последней версии файла …») и попадут в аудит красным (MarkedDelete). Строки других вкладок того же файла не затрагиваются. Физически строки НЕ удаляются — удаляйте вручную после проверки." />
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>